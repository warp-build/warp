"pub fn add_two(a: i32) -> i32 {\n    a + 2\n}\n\n#[cfg(test)]\nmod tests {\n\tuse super::*;\n\n    #[test]\n    fn add_two_and_two() {\n        assert_eq!(4, add_two(2));\n    }\n\n    #[test]\n    fn add_three_and_two() {\n        assert_eq!(5, add_two(3));\n    }\n\n    #[test]\n    fn one_hundred() {\n\t\tlet res = super::add_two(100);\n        assert_eq!(102, res);\n    }\n}\n\n#[test]\nfn no_mod_test_1() {\n    assert_eq!(4, add_two(2));\n}\n\n#[test]\nfn no_mod_test_2() {\n    assert_eq!(5, add_two(3));\n}\n\n#[test]\nfn add_4_and_two() {\n    assert_eq!(6, add_two(4));\n}\n"
